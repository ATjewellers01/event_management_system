# --- Backend secrets (server-side only) ---
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxx
GOOGLE_API_KEY=AIzaSyXxxxxxxxxxxxxxxxxxxxxxxx
GOOGLE_CSE_ID=xxxxxxxxxxxxxxxxx

# --- Apps Script web app URL ---
# Created by deploying FINAL_APPS_SCRIPT.js as a Web App in Apps Script.
# Must allow access from "Anyone" so the deployed backend can POST to it.
APPS_SCRIPT_URL=https://script.google.com/macros/s/XXXXX/exec

# --- Public deployment URL ---
# Used in QR codes and visitor-form links. Must match the address users hit
# in the browser. Used at runtime by the backend's /api/config endpoint.
PUBLIC_BASE_URL=https://event.example.com

# --- Turso / libSQL (optional) ---
# Both must be set for Turso to be used at all; if either is missing the app
# silently keeps reading and writing Google Sheets.
#   turso db show <db> --url        -> the URL below
#   turso db tokens create <db>     -> the token below
# Note the scheme is libsql:// (a turso:// value is auto-normalised).
TURSO_DB_URL=libsql://your-db-your-org.aws-ap-south-1.turso.io
TURSO_AUTH_TOKEN=eyJhbGciOi...

# Which backend the read endpoints use: 'sheets' (default) or 'turso'.
# Writes always go to Google Sheets until the migration is signed off.
DATA_SOURCE=sheets

# Cache TTL for sheet-backed reads, in seconds. 0 disables the cache.
CACHE_TTL_SECONDS=60
