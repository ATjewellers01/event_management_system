# ---------------------------------------------------------------------------
# Event Hub — backend configuration
#
# Data lives in Turso; card images live in Cloudinary. Google Sheets, Apps
# Script and Google Drive are no longer used anywhere in the app.
# ---------------------------------------------------------------------------

# --- OpenAI (business card OCR + enrichment) --- REQUIRED
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxx

# --- Google Programmable Search (company enrichment lookups) --- optional
# Only used to enrich scanned cards with web data. Safe to leave unset.
GOOGLE_API_KEY=AIzaSyXxxxxxxxxxxxxxxxxxxxxxxx
GOOGLE_CSE_ID=xxxxxxxxxxxxxxxxx

# --- Turso / libSQL (the only data store) --- REQUIRED
# The app refuses to start without these. There is no fallback, so booting
# without a database would only produce failures on every request.
#   turso db show <db> --url        -> the URL below
#   turso db tokens create <db>     -> the token below
# Scheme must be libsql:// (a turso:// value is normalised automatically).
TURSO_DB_URL=libsql://your-db-your-org.aws-ap-south-1.turso.io
TURSO_AUTH_TOKEN=eyJhbGciOi...

# --- Cloudinary (card image storage) --- REQUIRED for card photos
# Dashboard -> Product Environment Credentials.
# Card images are capped at 1600px and stored as WebP only, in event-hub/cards.
# WebP rather than AVIF: GPT-4o vision accepts png/jpeg/gif/webp and rejects
# AVIF, so an AVIF-only store would break any future re-OCR of a saved card.
# If these are unset the app still runs and still saves card DATA — only the
# photo upload is skipped, and that is logged rather than failing silently.
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=123456789012345
CLOUDINARY_API_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Public deployment URL --- REQUIRED in production
# Used to build QR-code and visitor-form links, so it must match the address
# users actually hit. Served to the frontend via /api/config.
PUBLIC_BASE_URL=https://event.example.com
