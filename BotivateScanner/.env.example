# --- BotivateScanner Vite build-time env ---
# Set this before running `npm run build` or pass it as a Docker build arg:
#   docker build --build-arg VITE_APPS_SCRIPT_URL=https://... -t atjewellers-app .
# The same Apps Script Web App URL the backend uses.
VITE_APPS_SCRIPT_URL=https://script.google.com/macros/s/XXXXX/exec
